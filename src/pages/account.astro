---
import Layout from "../layouts/Default.astro";

// API base URL for portal -> license-API calls. Lambda backend lives at
// api.mybodyprism.com (api-{env}.mybodyprism.com in non-prod). The build
// pulls the correct host from MBP_ENV at deploy time.
const apiBase =
  (import.meta.env.PUBLIC_API_BASE as string | undefined) ??
  "https://api.mybodyprism.com";
const portalReturnURL = "https://mybodyprism.com/account";
---

<Layout
  title="Account — MyBodyPrism"
  description="Your MyBodyPrism account. MyBodyPrism is free in this version."
>
  <section class="container">
    <h1>Your account</h1>

    <div id="mbp-account-loading">
      <p>Loading account…</p>
    </div>

    <div id="mbp-account-noauth" hidden>
      <p>
        We didn't find an active session. MyBodyPrism is free and there's no
        account to set up — head to <a href="/pricing">the download page</a>, or
        write to <a href="mailto:support@mybodyprism.com">support@mybodyprism.com</a>
        if you need a hand.
      </p>
    </div>

    <div id="mbp-account-main" hidden>
      <div class="grid">
        <div class="card">
          <h2>Your license</h2>
          <p id="mbp-tier-line">Desktop Viewer — free beta</p>
          <p>
            MyBodyPrism v1.1 is a free beta. Your licence activates itself the
            first time you launch the viewer, so there is nothing to set up or
            manage here. See the <a href="/legal/eula">EULA</a> for the full
            licence terms.
          </p>
          <p class="feedback-line">
            Found a bug, or something you wish it did?
            <a href="mailto:support@mybodyprism.com?subject=MyBodyPrism%20beta%20feedback"
              >Send beta feedback</a
            >.
          </p>
        </div>
      </div>
    </div>
  </section>

  <style>
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
      margin-top: 1.5rem;
    }
    .card {
      background: var(--c-panel);
      border: 1px solid var(--c-border);
      border-radius: 0.75rem;
      padding: 1.25rem;
    }
  </style>

  <script is:inline define:vars={{ apiBase, portalReturnURL }}>
    (function () {
      function $(id) { return document.getElementById(id); }
      const params = new URLSearchParams(location.search);

      // Auth token is passed by Stripe Customer Portal redirect (or, for
      // logged-in returning visitors, a cookie). In V1 we accept ?token=
      // from the URL.
      let token = params.get("token");
      if (!token) {
        try { token = localStorage.getItem("mbp.auth"); } catch (_) {}
      } else {
        try { localStorage.setItem("mbp.auth", token); } catch (_) {}
      }

      if (!token) {
        $("mbp-account-loading").hidden = true;
        $("mbp-account-noauth").hidden = false;
        // Fall back to /pricing per spec.
        setTimeout(function () { location.href = "/pricing"; }, 5000);
        return;
      }

      // Desktop-only in v1.1, and free: no usage or tier lookup, and no
      // commerce surface on this page. The Customer Portal link was unwired
      // 2026-09-16 with the rest of that copy; apiBase and portalReturnURL are
      // kept here for the day v1.2 needs them again.
      void apiBase; void portalReturnURL;
      $("mbp-account-loading").hidden = true;
      $("mbp-account-main").hidden = false;
    })();
  </script>
</Layout>

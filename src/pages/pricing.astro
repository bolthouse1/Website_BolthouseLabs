---
import Layout from "../layouts/Default.astro";

// API base URL for the trial-download + (future) checkout calls. The Lambda
// backend lives at api.mybodyprism.com (api-{env}.mybodyprism.com in non-prod);
// the build pulls the correct host from PUBLIC_API_BASE at deploy time.
const apiBase =
  (import.meta.env.PUBLIC_API_BASE as string | undefined) ??
  "https://api.mybodyprism.com";
---

<Layout
  title="Get MyBodyPrism — Free"
  description="The MyBodyPrism Desktop Viewer is free in this version. Enter your email and download. In this version, your imaging stays on your device."
>
  <section class="container">
    <h1>Get MyBodyPrism — free</h1>
    <p class="lede">
      The full MyBodyPrism viewer, as a <strong>free trial</strong> — no
      payment details needed, no time limit. Enter your email and download. In
      this version, your imaging stays on your device, and there's no AI
      processing.
    </p>

    <div class="tier-grid single">
      <!-- Desktop — the v1.1 product, free -->
      <div class="tier featured">
        <h2>Desktop Viewer</h2>
        <p class="price"><span>Free</span></p>
        <ul>
          <li>Full local viewer (Windows)</li>
          <li>2D / MPR / MIP / volume rendering</li>
          <li>In this version, your imaging stays on your device</li>
          <li>One install per machine</li>
          <li>Free — no time limit in this version</li>
        </ul>
        <form id="mbp-trial-form" novalidate>
          <label class="visually-hidden" for="mbp-trial-email">Email address</label>
          <input
            id="mbp-trial-email"
            type="email"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
          <button id="mbp-trial-btn" type="submit" class="btn btn-primary">
            Download free
          </button>
          <p class="form-note">
            We'll use your email to follow up about your experience and tell you
            about updates — nothing else. See the
            <a href="/legal/privacy">Privacy Policy</a>.
          </p>
          <p id="mbp-trial-error" class="form-error" hidden role="alert">
            Couldn't start the download. Check your email address and retry, or
            write to <a href="mailto:support@mybodyprism.com">support@mybodyprism.com</a>.
          </p>
          <p id="mbp-trial-ok" class="form-ok" hidden role="status">
            Your download is starting… (~2.5&nbsp;GB). The installer includes
            sample imaging so you can explore right away.
          </p>
        </form>
      </div>
    </div>

    <p class="muted">
      MyBodyPrism is free in this version. Free access isn't guaranteed to last
      forever — we may add paid features in the future (browser-based streaming,
      when it arrives, will be paid), and we'll give registered users notice
      before anything changes. See the <a href="/legal/eula">EULA</a> and
      <a href="/legal/tos">Terms of Service</a> for the full terms.
    </p>
  </section>

  <style>
    h1 { margin-top: 2rem; }
    .lede { color: var(--c-muted); max-width: 720px; }
    .tier-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
      margin: 2rem 0;
    }
    /* Single-tier layout (Desktop only in v1.1): keep the card at a
       readable width instead of stretching it full-bleed. */
    .tier-grid.single { grid-template-columns: minmax(280px, 460px); }
    .tier {
      border: 1px solid var(--c-border);
      border-radius: 0.75rem;
      padding: 1.5rem;
      background: var(--c-panel);
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .tier.featured {
      border-color: var(--c-brand);
      box-shadow: 0 0 40px rgba(0, 212, 255, 0.10);
    }
    .tier.soon { opacity: 0.72; }
    .tier h2 { margin: 0; color: var(--c-brand); }
    .tier .price { font-size: 1rem; color: var(--c-muted); margin: 0; }
    .tier .price span { font-size: 1.9rem; color: var(--c-fg); font-weight: 700; }
    .tier.soon .price span { font-size: 1.5rem; color: var(--c-muted); }
    .subprice { color: var(--c-muted); margin: 0; font-size: 0.95rem; }
    .tier ul { padding-left: 1.1rem; margin: 0; }
    .tier ul li { margin-bottom: 0.3rem; }
    .tier .btn { text-align: center; }
    .tier .btn[aria-disabled="true"] { opacity: 0.55; cursor: default; pointer-events: none; }
    #mbp-trial-form { display: flex; flex-direction: column; gap: 0.5rem; }
    #mbp-trial-form input[type="email"] {
      padding: 0.6rem 0.75rem;
      border: 1px solid var(--c-border);
      border-radius: 0.5rem;
      font-size: 1rem;
    }
    .form-note { color: var(--c-muted); font-size: 0.8rem; margin: 0; }
    .form-error { color: #ff8a7a; font-size: 0.9rem; margin: 0; }
    .form-ok { color: #5be0a0; font-size: 0.9rem; margin: 0; }
    .visually-hidden {
      position: absolute; width: 1px; height: 1px;
      margin: -1px; padding: 0; overflow: hidden;
      clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
    .comparison { overflow-x: auto; margin: 1rem 0 2rem; }
    table { width: 100%; border-collapse: collapse; }
    th, td {
      padding: 0.6rem 0.85rem;
      border-bottom: 1px solid var(--c-border);
      text-align: left;
    }
    thead th { background: var(--c-accent); }
    tbody th { font-weight: 600; }
  </style>

  <script is:inline define:vars={{ apiBase }}>
    (function () {
      var form = document.getElementById("mbp-trial-form");
      var input = document.getElementById("mbp-trial-email");
      var btn = document.getElementById("mbp-trial-btn");
      var err = document.getElementById("mbp-trial-error");
      var ok = document.getElementById("mbp-trial-ok");
      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var email = (input.value || "").trim();
        if (!email || email.indexOf("@") < 1) {
          err.hidden = false;
          return;
        }
        btn.disabled = true;
        var original = btn.textContent;
        btn.textContent = "Preparing download…";
        err.hidden = true;
        ok.hidden = true;
        fetch(apiBase + "/downloads/trial-installer", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email }),
        })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (data) {
            if (data && data.url) {
              ok.hidden = false;
              btn.textContent = "Downloading…";
              location.href = data.url;
              setTimeout(function () {
                btn.disabled = false;
                btn.textContent = original;
              }, 8000);
            } else {
              throw new Error("no url");
            }
          })
          .catch(function () {
            btn.disabled = false;
            btn.textContent = original;
            err.hidden = false;
          });
      });
    })();
  </script>
</Layout>

---
import Layout from "../layouts/Default.astro";
---

<Layout title="Not found — MyBodyPrism" description="The page you wanted isn't here.">
  <section class="container narrow">
    <h1>Not found</h1>
    <p>
      The page you wanted isn't here. It may have moved, or the link may
      have been miscopied. Try the <a href="/">home page</a>, the
      <a href="/pricing">pricing page</a>, or
      <a href="mailto:support@mybodyprism.com">tell us what you were
      looking for</a>.
    </p>
  </section>
  <style>
    .narrow { max-width: 720px; padding: 4rem 1.25rem 6rem; }
  </style>
</Layout>

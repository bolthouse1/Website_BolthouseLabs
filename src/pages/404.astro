---
import Layout from "../layouts/Default.astro";
---

<Layout title="Not found — MyBodyPrism" description="The page you wanted isn't here.">
  <script is:inline>
    // Every route 404s with a trailing slash: build.format "file" emits
    // /pricing.html, not /pricing/index.html. GitHub Pages serves this page
    // for those misses (verified 2026-09-12), so bounce them to the slashless
    // path, keeping the query string and anchor. A genuinely missing page just
    // 404s again at the slashless URL, which no longer ends in "/", so this
    // cannot loop.
    (function () {
      var p = location.pathname;
      if (p.length > 1 && p.charAt(p.length - 1) === "/") {
        location.replace((p.replace(/\/+$/, "") || "/") + location.search + location.hash);
      }
    })();
  </script>
  <section class="container narrow">
    <h1>Not found</h1>
    <p>
      The page you wanted isn't here. It may have moved, or the link may
      have been miscopied. Try the <a href="/">home page</a>, the
      <a href="/pricing">pricing page</a>, or
      <a href="mailto:support@mybodyprism.com">tell us what you were
      looking for</a>.
    </p>
  </section>
  <style>
    .narrow { max-width: 720px; padding: 4rem 1.25rem 6rem; }
  </style>
</Layout>

---
import Layout from "../layouts/Default.astro";
import { DOWNLOADS_LIVE, PRIMARY_CTA } from "../site-config";

// Launch homepage. This is the teaser's scroll-driven narrative arc (hero ->
// diagnosis -> pivot -> reveal -> progression -> detail -> markup -> trust)
// with the pre-launch waitlist replaced by the download CTA, which lives on
// /pricing. The founder prose is carried across verbatim from the pre-migration
// marketing index; the medical specifics are the owner's own history and must
// not be paraphrased.
---

<Layout
  title="MyBodyPrism — See yourself like never before"
  description="A desktop viewer that turns your own DICOM scans into immersive, explorable 3D — running entirely on your machine, where your data stays."
  bare={true}
>
  <script is:inline>
    // Opt in to reveal animations only when JS is running, so the page is
    // fully readable with JS disabled instead of rendering blank.
    document.documentElement.classList.add("js-reveal");
  </script>

  <!-- 1. HERO -->
  <section class="hero">
    <canvas id="particles" aria-hidden="true"></canvas>
    <div class="hero-content">
      <img class="hero-logo" src="/logo-mark-t.png" alt="MyBodyPrism" />
      <h1>What if you could truly see inside your own body?</h1>
      <p class="lead hero-lead">
        A desktop viewer that turns your own medical scans into immersive,
        explorable 3D — running entirely on your machine.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={PRIMARY_CTA.href}>{PRIMARY_CTA.label}</a>
        <a class="btn btn-secondary" href="/system-requirements">System requirements</a>
      </div>
    </div>
    <div class="scroll-cue" id="scroll-cue">Scroll</div>
  </section>

  <!-- 2. INTRODUCING -->
  <section class="section-product">
    <div class="container narrative">
      <p class="eyebrow reveal">Introducing</p>
      <h2 class="product-name reveal reveal-delay-1">MyBodyPrism</h2>
      <p class="lead reveal reveal-delay-2">
        A desktop app that turns your DICOM scans into immersive, explorable 3D —
        on your own machine, where your data stays.
      </p>
      <div class="app-window reveal reveal-delay-3">
        <div class="win-bar">
          <span class="win-dot" style="background:#ff5f56"></span>
          <span class="win-dot" style="background:#ffbd2e"></span>
          <span class="win-dot" style="background:#27c93f"></span>
          <span class="label">MyBodyPrism — Multi-view</span>
        </div>
        <img
          src="/Picture2.png"
          alt="MyBodyPrism showing CT-PET data across multiple synchronized 2D and 3D views"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- 3. THE DIAGNOSIS -->
  <section>
    <div class="container narrative">
      <p class="eyebrow reveal">2013</p>
      <h2 class="reveal reveal-delay-1">I was diagnosed with cardiac sarcoidosis.</h2>
      <p class="lead reveal reveal-delay-2">
        This is what I saw on the medical scan CD they gave me.
      </p>
      <figure class="reveal reveal-delay-3 figure-large">
        <img
          src="/Picture1.png"
          alt="Traditional DICOM viewer with four panels showing flat 2D cross-sections and a 'No 3D' panel"
          loading="lazy"
          decoding="async"
        />
        <figcaption>A traditional viewer. Grayscale cross-sections.</figcaption>
      </figure>
    </div>
  </section>

  <!-- 4. EMOTIONAL PIVOT -->
  <section class="section-pivot">
    <div class="container narrative container-narrow">
      <p class="quote reveal">"I couldn't understand my own disease."</p>
      <div class="accent-line reveal reveal-delay-1"></div>
    </div>
  </section>

  <!-- 5. WHY THIS EXISTS (founder prose — verbatim) -->
  <section class="section-founder">
    <div class="container narrative container-prose">
      <h2 class="reveal">Why this exists</h2>
      <p class="reveal reveal-delay-1">
        I survived a sudden cardiac arrest. While recovering I discovered that
        the medical images describing the inside of my chest were locked behind
        portals I couldn't browse, formats I couldn't open, and rules that
        treated me as a stranger to my own body. I had spent twenty-eight years
        writing visualization software for cardiac surgeons; the irony was
        unmissable.
      </p>
      <p class="reveal reveal-delay-2">
        MyBodyPrism is what I wanted on the day I came home from the hospital.
        It's a self-pay viewer that runs on your own machine — not a service
        that ingests your PHI. There is no upload and no AI processing. Your
        data stays yours.
      </p>
    </div>
  </section>

  <!-- 6. THE REVEAL -->
  <section>
    <div class="container narrative">
      <h2 class="reveal">So I built something better.</h2>
      <div class="app-window wide reveal reveal-delay-1">
        <div class="win-bar">
          <span class="win-dot" style="background:#ff5f56"></span>
          <span class="win-dot" style="background:#ffbd2e"></span>
          <span class="win-dot" style="background:#27c93f"></span>
          <span class="label">MyBodyPrism — Volumetric heart</span>
        </div>
        <img
          src="/Picture4.png"
          alt="Volumetric 3D rendering of a human heart with PET signal and scar tissue visualized as a glowing heatmap"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="standalone reveal reveal-delay-2">
        My heart. PET signal layered over volumetric anatomy. Scar tissue
        rendered as a heatmap.
      </figcaption>
    </div>
  </section>

  <!-- 7. MULTI-YEAR -->
  <section>
    <div class="container narrative">
      <p class="eyebrow reveal">2013 → 2025</p>
      <h2 class="reveal reveal-delay-1">Multi-Year Progression</h2>
      <p class="lead reveal reveal-delay-2">MyBodyPrism Comparison Mode.</p>
      <figure class="reveal reveal-delay-3">
        <img
          src="/Picture3.png"
          alt="Side-by-side comparison of four cardiac PET-CT scans from 2013, 2018, 2023, and 2025"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- 8. EVERY DETAIL -->
  <section>
    <div class="container narrative">
      <h2 class="reveal">See Every Detail</h2>
      <div class="app-window reveal reveal-delay-1">
        <div class="win-bar">
          <span class="win-dot" style="background:#ff5f56"></span>
          <span class="win-dot" style="background:#ffbd2e"></span>
          <span class="win-dot" style="background:#27c93f"></span>
          <span class="label">MyBodyPrism — CT bone / metal</span>
        </div>
        <img
          src="/Picture5.png"
          alt="Volumetric CT render tuned to bone and metal density, revealing an implanted ICD, lead, and sternal wires"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="standalone reveal reveal-delay-2">
        CT tuned to show bone and metal, revealing my ICD, wires and leads.
      </figcaption>
    </div>
  </section>

  <!-- 9. MARK WHAT MATTERS -->
  <section>
    <div class="container narrative">
      <h2 class="reveal">Highlight Your Data</h2>
      <p class="lead reveal reveal-delay-1">
        Custom markup tools to make your scans tell your story.
      </p>
      <figure class="reveal reveal-delay-2">
        <img
          src="/Picture6.png"
          alt="Annotation tool tracing an ICD lead through three views of the chest"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- 10. HOW IT WORKS -->
  <section class="section-how">
    <div class="container narrative container-prose">
      <h2 class="reveal">How it works</h2>
      <ol class="reveal reveal-delay-1">
        <li><strong>Download free.</strong> Enter your email on the download page and get the viewer — free beta, no payment details needed, valid until July 1, 2027.</li>
        <li><strong>Open your scans.</strong> Drop a CD, USB stick, or zip from your hospital portal into the viewer. Render in 2D, MPR, MIP, and volume modes.</li>
      </ol>
      {
        /* Additive pre-launch note. The two steps above are owner-directed copy
           and are left untouched in both states; this only says they describe
           launch behaviour, so the page doesn't promise a download that the
           gated /pricing page can't yet deliver. */
        !DOWNLOADS_LIVE && (
          <p class="notice reveal reveal-delay-2">
            <strong>Not available to download yet.</strong> The viewer is in
            final testing — the steps above are how it will work at launch. Join
            the waitlist and we'll email you the moment it's ready.
          </p>
        )
      }
      <p class="muted reveal reveal-delay-2">
        A free beta, valid until July 1, 2027 — and genuinely early, so
        <a href="mailto:support@mybodyprism.com?subject=MyBodyPrism%20beta%20feedback"
          >tell us what breaks and what you wish it did</a
        >. We may add paid features later (browser-based streaming will be paid);
        we'll give registered users notice first.
      </p>
    </div>
  </section>

  <!-- 11. TRUST STRIP -->
  <section class="section-trust">
    <div class="container narrative">
      <div class="trust-row">
        <div class="trust-badge reveal"><div class="trust-title">Runs entirely on your computer</div></div>
        <div class="trust-badge reveal reveal-delay-1"><div class="trust-title">No uploads, no cloud</div></div>
        <div class="trust-badge reveal reveal-delay-2"><div class="trust-title">Your data stays yours</div></div>
      </div>
    </div>
  </section>

  <!-- 12. FINAL CTA -->
  <section class="section-cta">
    <div class="glow" aria-hidden="true"></div>
    <div class="container narrative container-narrow">
      <h2 class="reveal">
        {DOWNLOADS_LIVE ? "See yourself like never before." : "Be the first to see yourself like never before."}
      </h2>
      <p class="lead reveal reveal-delay-1">
        {
          DOWNLOADS_LIVE
            ? "The full MyBodyPrism viewer, free — no payment details needed. A beta licence valid until July 1, 2027. Windows 10/11."
            : "The full MyBodyPrism viewer will be a free beta — no payment details needed, valid until July 1, 2027. Leave your email and we'll tell you the moment it's ready. Windows 10/11."
        }
      </p>
      <div class="cta-row centered reveal reveal-delay-2">
        <a class="btn btn-primary" href={PRIMARY_CTA.href}>{PRIMARY_CTA.label}</a>
        <a class="btn btn-secondary" href="/support">Questions?</a>
      </div>
    </div>
  </section>

  <style>
    /* ---------- Section base ---------- */
    section {
      position: relative;
      padding: 5rem 2rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .narrative { text-align: center; }
    .container-narrow { max-width: 640px; }
    .container-prose { max-width: 720px; text-align: left; }

    .eyebrow {
      font-size: 0.7rem;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: var(--c-brand);
      margin-bottom: 1.5rem;
      font-weight: 400;
    }
    h1 { font-size: clamp(2rem, 6vw, 4.5rem); max-width: 22ch; margin: 0 auto; }
    h2 { font-size: clamp(1.75rem, 4.5vw, 3.25rem); max-width: 24ch; margin: 0 auto 1rem; }
    .container-prose h2 { margin-left: 0; }
    p { color: var(--c-muted); }
    .lead {
      font-size: clamp(1.05rem, 1.5vw, 1.25rem);
      max-width: 56ch;
      margin: 0 auto;
      color: var(--c-muted);
      line-height: 1.65;
    }

    /* ---------- HERO ---------- */
    .hero {
      min-height: calc(100vh - 4rem);
      padding: 5rem 2rem 4rem;
      overflow: hidden;
      background:
        radial-gradient(720px 520px at 50% 38%, rgba(0, 212, 255, 0.10), transparent 70%),
        var(--c-bg);
    }
    #particles {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      opacity: 0.55;
    }
    .hero-content {
      position: relative;
      z-index: 1;
      text-align: center;
      max-width: 900px;
    }
    .hero-logo {
      display: block;
      width: min(260px, 55vw);
      height: auto;
      margin: 0 auto 2rem;
      filter: drop-shadow(0 0 48px rgba(0, 212, 255, 0.18));
    }
    .hero h1 { margin-bottom: 1.5rem; }
    .hero-lead { margin-bottom: 2.25rem; }
    .cta-row { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; }
    .scroll-cue {
      position: absolute;
      bottom: 2.5rem;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.7rem;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: var(--c-dim);
      transition: opacity 0.4s;
      z-index: 1;
    }
    .scroll-cue::after {
      content: "";
      display: block;
      width: 1px;
      height: 32px;
      background: linear-gradient(to bottom, var(--c-dim), transparent);
      margin: 0.75rem auto 0;
    }
    .scroll-cue.faded { opacity: 0; }

    /* ---------- Figures ---------- */
    figure { margin: 1.75rem auto 0; max-width: 880px; }
    figure img {
      display: block;
      width: 100%;
      border-radius: 4px;
      box-shadow:
        0 0 0 1px var(--c-border),
        0 24px 80px rgba(0, 0, 0, 0.6),
        0 0 120px rgba(0, 212, 255, 0.04);
    }
    .figure-large { max-width: 960px; }
    figcaption {
      margin-top: 1.25rem;
      font-size: 0.85rem;
      color: var(--c-dim);
      letter-spacing: 0.05em;
      font-style: italic;
      max-width: 56ch;
      margin-left: auto;
      margin-right: auto;
    }
    figcaption.standalone { display: block; }

    /* ---------- App window ---------- */
    .app-window {
      margin: 1.75rem auto 0;
      max-width: 900px;
      background: var(--c-panel);
      border: 1px solid var(--c-border-strong);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.55), 0 0 90px rgba(0, 212, 255, 0.10);
    }
    .app-window.wide { max-width: 980px; }
    .win-bar {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 0.95rem;
      background: var(--c-bg-2);
      border-bottom: 1px solid var(--c-border);
    }
    .win-dot { width: 9px; height: 9px; border-radius: 50%; }
    .win-bar .label {
      margin-left: 0.55rem;
      font-size: 0.68rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--c-dim);
    }
    .app-window img { display: block; width: 100%; border-radius: 0; box-shadow: none; }

    /* ---------- Pivot quote ---------- */
    .section-pivot { padding: 3.5rem 2rem; }
    .quote {
      font-family: "Playfair Display", Georgia, serif;
      font-style: italic;
      font-weight: 400;
      font-size: clamp(1.5rem, 3.5vw, 2.5rem);
      line-height: 1.4;
      color: var(--c-fg);
      max-width: 22ch;
      margin: 0 auto;
    }
    .accent-line {
      width: 60px;
      height: 1px;
      background: var(--c-brand);
      margin: 2.5rem auto 0;
      opacity: 0.7;
    }

    /* ---------- Product / founder / how ---------- */
    .section-product, .section-founder, .section-how { background: var(--c-bg-2); }
    .product-name {
      font-size: clamp(2.25rem, 5.5vw, 3.75rem);
      letter-spacing: -0.01em;
      margin-bottom: 1.5rem;
    }
    .section-founder p { margin-bottom: 1.1rem; }
    .section-how ol { padding-left: 1.2rem; margin: 0 0 1.25rem; }
    .section-how li { margin-bottom: 0.7rem; color: var(--c-muted); }
    .muted { color: var(--c-dim); font-size: 0.92rem; }
    /* .notice base lives in the layout's global block; only spacing here. */
    .notice { margin: 0 0 1.1rem; }

    /* ---------- Trust strip ---------- */
    .section-trust { padding: 3rem 2rem; background: var(--c-bg); }
    .trust-row {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 4rem;
      flex-wrap: wrap;
    }
    .trust-badge { display: flex; align-items: center; gap: 0.75rem; }
    .trust-badge::before {
      content: "";
      width: 6px;
      height: 6px;
      background: var(--c-brand);
      border-radius: 50%;
      opacity: 0.7;
    }
    .trust-title {
      font-size: 0.85rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--c-muted);
    }

    /* ---------- Final CTA ---------- */
    .section-cta { padding: 4.5rem 2rem 5.5rem; overflow: hidden; }
    .section-cta .glow {
      position: absolute;
      width: 560px;
      height: 360px;
      left: 50%;
      top: 26%;
      transform: translateX(-50%);
      background: radial-gradient(closest-side, rgba(0, 212, 255, 0.13), transparent);
      filter: blur(50px);
      pointer-events: none;
      z-index: 0;
    }
    .section-cta .container { position: relative; z-index: 1; }
    .section-cta h2 { margin-bottom: 1.25rem; }
    .cta-row.centered { margin-top: 2.25rem; }

    /* ---------- Reveal animation (JS-gated) ---------- */
    :global(.js-reveal) .reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.9s ease, transform 0.9s ease;
    }
    :global(.js-reveal) .reveal.visible { opacity: 1; transform: none; }
    .reveal-delay-1 { transition-delay: 0.15s; }
    .reveal-delay-2 { transition-delay: 0.3s; }
    .reveal-delay-3 { transition-delay: 0.45s; }

    @media (prefers-reduced-motion: reduce) {
      :global(.js-reveal) .reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
      .scroll-cue { transition: none; }
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 768px) {
      section { padding: 3.5rem 1.25rem; }
      .hero { padding: 4rem 1.25rem 3rem; }
      figure, .app-window { margin-top: 1.5rem; }
      .trust-row { gap: 1.75rem; flex-direction: column; }
      .scroll-cue { bottom: 1.5rem; }
      .hero-logo { margin-bottom: 1.75rem; }
    }
  </style>

  <script is:inline>
    // -- Particle field on hero --
    (function () {
      var canvas = document.getElementById("particles");
      if (!canvas) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      var ctx = canvas.getContext("2d");
      if (!ctx) return;
      var w, h, particles;
      var COUNT = 60;
      var LINK_DIST = 140;
      var dpr = window.devicePixelRatio || 1;

      function resize() {
        w = canvas.width = canvas.offsetWidth * dpr;
        h = canvas.height = canvas.offsetHeight * dpr;
      }
      function init() {
        particles = Array.from({ length: COUNT }, function () {
          return {
            x: Math.random() * w,
            y: Math.random() * h,
            vx: (Math.random() - 0.5) * 0.3 * dpr,
            vy: (Math.random() - 0.5) * 0.3 * dpr,
            r: (Math.random() * 1.5 + 0.5) * dpr,
          };
        });
      }
      function tick() {
        ctx.clearRect(0, 0, w, h);
        for (var k = 0; k < particles.length; k++) {
          var p = particles[k];
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1;
          if (p.y < 0 || p.y > h) p.vy *= -1;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = "rgba(0, 212, 255, 0.55)";
          ctx.fill();
        }
        for (var i = 0; i < particles.length; i++) {
          for (var j = i + 1; j < particles.length; j++) {
            var a = particles[i], b = particles[j];
            var dx = a.x - b.x, dy = a.y - b.y;
            var dist = Math.sqrt(dx * dx + dy * dy);
            var link = LINK_DIST * dpr;
            if (dist < link) {
              ctx.beginPath();
              ctx.moveTo(a.x, a.y);
              ctx.lineTo(b.x, b.y);
              ctx.strokeStyle = "rgba(0, 212, 255, " + 0.18 * (1 - dist / link) + ")";
              ctx.lineWidth = dpr * 0.5;
              ctx.stroke();
            }
          }
        }
        requestAnimationFrame(tick);
      }
      resize();
      init();
      tick();
      window.addEventListener("resize", function () { resize(); init(); });
    })();

    // -- Scroll reveal --
    (function () {
      var items = document.querySelectorAll(".reveal");
      if (!("IntersectionObserver" in window)) {
        for (var i = 0; i < items.length; i++) items[i].classList.add("visible");
        return;
      }
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add("visible");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -40px 0px" }
      );
      items.forEach(function (el) { io.observe(el); });
    })();

    // -- Scroll cue fade --
    (function () {
      var cue = document.getElementById("scroll-cue");
      if (!cue) return;
      window.addEventListener(
        "scroll",
        function () { if (window.scrollY > 80) cue.classList.add("faded"); },
        { passive: true }
      );
    })();
  </script>
</Layout>

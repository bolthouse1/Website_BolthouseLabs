---
// Default site layout: <head> with OG/Twitter meta + favicon, header
// (logo + nav), and footer (legal links + diagnostic-use disclaimer).
//
// Theme: the MyBodyPrism brand is dark/cinematic (see CLAUDE.md "Brand
// Identity"). Every colour below is a --c-* custom property so page-level
// styles inherit the palette; do not hardcode colours in pages.
//
// Usage: <Layout title="..." description="..."> <slot/> </Layout>
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Set on the homepage, which supplies its own full-bleed hero. */
  bare?: boolean;
}

const {
  title = "MyBodyPrism — Your medical imaging, in your hands",
  description = "MyBodyPrism is a desktop viewer for your own medical imaging. Take control of your DICOM scans. For personal review only — not approved for medical diagnosis.",
  image = "/logo.png",
  bare = false,
} = Astro.props;

// astro.config sets build.format "file", so Astro.url.pathname is "/pricing.html"
// at build time. Strip the extension so the canonical matches the extensionless
// URLs used by every internal link and by the sitemap; otherwise the same page
// advertises two different addresses.
const canonicalPath = Astro.url.pathname
  .replace(/index\.html$/, "")
  .replace(/\.html$/, "");
const canonicalURL = new URL(canonicalPath, Astro.site).toString();
const ogImageURL = new URL(image, Astro.site).toString();
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050508" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="MyBodyPrism" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      :root {
        --c-bg: #050508;
        --c-bg-2: #08080d;
        --c-panel: #0b0b12;
        --c-fg: #e8e6ea;
        --c-muted: #8a8790;
        --c-dim: #4a4850;
        --c-border: rgba(255, 255, 255, 0.08);
        --c-border-strong: rgba(255, 255, 255, 0.12);
        --c-brand: #00d4ff;
        --c-brand-2: #7fe7ff;
        --c-warm: #ff6b4a;
        /* Panel/tint surface. Named "accent" for backwards compatibility with
           page styles that use it as a raised background (table headers,
           footer, secondary-button hover). */
        --c-accent: #0b0b12;
        --c-warn: #ffb26b;
        --max-w: 1100px;
        font-family: "Outfit", ui-sans-serif, system-ui, -apple-system,
          "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        color-scheme: dark;
      }
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        color: var(--c-fg);
        background: var(--c-bg);
        line-height: 1.6;
        font-weight: 300;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }
      img { max-width: 100%; height: auto; }
      a { color: var(--c-brand); text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
      a:hover { color: var(--c-brand-2); }
      h1, h2, h3 {
        font-family: "Playfair Display", Georgia, serif;
        font-weight: 400;
        line-height: 1.18;
        margin-top: 0;
        color: var(--c-fg);
      }
      strong { font-weight: 600; color: var(--c-fg); }
      .container { max-width: var(--max-w); margin: 0 auto; padding: 0 1.25rem; }
      .btn {
        display: inline-block;
        padding: 0.7rem 1.35rem;
        border-radius: 3px;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.85rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        border: 1px solid transparent;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.2s, background 0.2s, color 0.2s;
      }
      .btn-primary {
        background: var(--c-brand);
        color: #050508;
        box-shadow: 0 0 30px rgba(0, 212, 255, 0.22);
      }
      .btn-primary:hover { opacity: 0.92; transform: translateY(-1px); color: #050508; }
      .btn-secondary {
        background: transparent;
        color: var(--c-brand);
        border-color: rgba(0, 212, 255, 0.35);
      }
      .btn-secondary:hover { background: rgba(0, 212, 255, 0.07); color: var(--c-brand-2); }
      .site-header {
        border-bottom: 1px solid var(--c-border);
        padding: 1rem 0;
        background: rgba(5, 5, 8, 0.85);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
        z-index: 900;
      }
      .site-header .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-weight: 500;
        font-size: 1.05rem;
        letter-spacing: 0.02em;
        color: var(--c-fg);
        text-decoration: none;
      }
      .brand:hover { color: var(--c-fg); }
      .brand-mark {
        display: block;
        width: 1.6rem;
        height: 1.6rem;
        object-fit: contain;
        filter: drop-shadow(0 0 10px rgba(0, 212, 255, 0.35));
      }
      nav.primary a {
        margin-left: 1.35rem;
        text-decoration: none;
        color: var(--c-muted);
        font-weight: 400;
        font-size: 0.9rem;
      }
      nav.primary a:hover { color: var(--c-brand); }
      main { min-height: 60vh; }
      main.padded { padding: 2.5rem 0 4rem; }
      table { width: 100%; border-collapse: collapse; }
      .site-footer {
        border-top: 1px solid var(--c-border);
        background: var(--c-bg-2);
        padding: 2.5rem 0;
        font-size: 0.85rem;
        color: var(--c-muted);
      }
      .site-footer .container { display: grid; gap: 1.1rem; }
      .site-footer a {
        color: var(--c-muted);
        text-decoration: none;
        margin-right: 1.15rem;
        line-height: 2;
      }
      .site-footer a:hover { color: var(--c-brand); }
      .disclaimer {
        background: rgba(255, 107, 74, 0.07);
        border: 1px solid rgba(255, 107, 74, 0.28);
        color: var(--c-warn);
        padding: 0.8rem 1rem;
        border-radius: 4px;
        font-size: 0.86rem;
      }
      .disclaimer strong { color: var(--c-warm); }

      /* Prose defaults for the Markdown-rendered legal pages, which drop
         their body straight into <main> with no page component. */
      .container.narrow { max-width: 760px; }
      main h1 { font-size: clamp(1.9rem, 4vw, 2.75rem); }
      main h2 { font-size: clamp(1.35rem, 2.4vw, 1.75rem); margin-top: 2.25rem; }
      main h3 { font-size: 1.1rem; margin-top: 1.75rem; }
      main p, main li { color: var(--c-muted); }
      main li { margin-bottom: 0.35rem; }
      main hr { border: 0; border-top: 1px solid var(--c-border); margin: 2.5rem 0; }
      main th, main td {
        padding: 0.6rem 0.85rem;
        border-bottom: 1px solid var(--c-border);
        text-align: left;
        vertical-align: top;
      }
      main thead th { background: var(--c-panel); color: var(--c-fg); }
      main code {
        background: var(--c-panel);
        border: 1px solid var(--c-border);
        border-radius: 3px;
        padding: 0.1em 0.35em;
        font-size: 0.9em;
      }
      main pre {
        background: var(--c-panel);
        border: 1px solid var(--c-border);
        border-radius: 4px;
        padding: 1rem;
        overflow-x: auto;
      }
      main pre code { background: none; border: 0; padding: 0; }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
      @media (max-width: 768px) {
        .site-header { position: static; }
        .site-header .container { justify-content: center; }
        nav.primary a { margin: 0 0.6rem; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <img class="brand-mark" src="/logo-mark-t.png" alt="" width="26" height="26" />
          MyBodyPrism
        </a>
        <nav class="primary" aria-label="Primary">
          <a href="/pricing">Pricing</a>
          <a href="/support">Support</a>
          <a href="/system-requirements">Requirements</a>
          <a href="/account">Account</a>
        </nav>
      </div>
    </header>

    <main class={bare ? "" : "padded"}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="disclaimer">
          <strong>Disclaimer:</strong> For personal review only. Not approved for
          medical diagnosis. Consult a licensed physician for medical decisions.
        </p>
        <nav aria-label="Legal">
          <a href="/legal/eula">EULA</a>
          <a href="/legal/tos">Terms of Service</a>
          <a href="/legal/privacy">Privacy</a>
          <a href="/legal/disclaimer">Medical Disclaimer</a>
          <a href="/legal/copyright">Open-source notices</a>
          <a href="/support">Support</a>
        </nav>
        <p>&copy; {year} Bolthouse Labs, Inc. All rights reserved.</p>
      </div>
    </footer>

    <CookieBanner />
  </body>
</html>
